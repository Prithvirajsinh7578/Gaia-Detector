# ===========================================================
# Gaia Detector — Backend Environment Variables
# ===========================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ===========================================================

# ----------------------------------------------------------
# MongoDB Atlas
# ----------------------------------------------------------
# Get this from: Atlas → Connect → Connect your application
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://24bt04104_db_user:wE0Xx5DbycgKFqEe@cluster0.kimdsj7.mongodb.net"
# Database name (used if not embedded in MONGODB_URI)
MONGODB_DB_NAME=Gaia 

# ----------------------------------------------------------
# JWT Authentication (httpOnly cookies)
# ----------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=PLACEHOLDER_CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

# Token lifetime in minutes (default: 7 days = 10080)
JWT_EXPIRY_MINUTES=10080

# ----------------------------------------------------------
# Cookie Security
# ----------------------------------------------------------
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# SameSite policy: strict | lax | none
# Use "none" only with COOKIE_SECURE=true (for cross-origin)
COOKIE_SAMESITE=lax

# Cookie name used for the JWT
COOKIE_NAME=gaia_access_token

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Comma-separated list of allowed frontend origins
# Example: http://localhost:5173,https://yourapp.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------
# Google Drive
# ----------------------------------------------------------
# Step 1: Create a Google Cloud project
# Step 2: Enable the Google Drive API
# Step 3: Create a Service Account → download JSON key
# Step 4: Share your Drive folder with the service account email
# Step 5: Paste the absolute path to the JSON key file below
#         OR paste the JSON content as a single-line string.
#
# Option A: path to the JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON_PATH="C:/Users/parzi/Desktop/Gaia_1/backend/credentials/gaia-detector-511517-b5354fb8d3a1.json"

# Option B: JSON content inline (escape all quotes)
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type":"service_account","project_id":"..."}

# The Google Drive folder ID where uploaded files will be stored.
# Get it from the URL: drive.google.com/drive/folders/<FOLDER_ID>
# Share this folder with the service account email (editor role).
GOOGLE_DRIVE_FOLDER_ID=146m1dYGQ9Y29Mg5PHj54hVToRZ1UvQbn

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Environment: development | production
APP_ENV=development

# ----------------------------------------------------------
# File Upload Limits
# ----------------------------------------------------------
# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=50
