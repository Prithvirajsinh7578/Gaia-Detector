# =================================================================
# GAIA DETECTOR - HYBRID AI TEXT DETECTION SYSTEM CONFIGURATION
# =================================================================

# Python Environment Path
PYTHONPATH=D:\MIne\CO4\AWTSE\detector;D:\MIne\CO4\AWTSE\detector\video_detector;C:\Users\vikra\AppData\Local\Programs\Python\Python313\Lib\site-packages

# 1. Pretrained Hugging Face Text Classifier
ENABLE_HF_TEXT_DETECTOR=true
HF_TEXT_MODEL_REPO=openai-community/roberta-base-openai-detector
HF_DEVICE=auto  # 'cuda', 'cpu', or 'auto'

# 2. Commercial GPTZero Text Detection API (Optional)
ENABLE_GPTZERO_API=true
GPTZERO_API_KEY=
GPTZERO_TIMEOUT_SECONDS=25

# 3. Decision Policies & Thresholds
ENSEMBLE_STRATEGY=calibrated_weighted
AI_TEXT_THRESHOLD=65.0
HUMAN_TEXT_THRESHOLD=35.0
CONFLICT_DISCREPANCY_THRESHOLD=45.0

# 4. Text Length Limits
MIN_ANALYSIS_CHAR_COUNT=30
MAX_CHUNK_TOKENS=512
