# ==============================================================================
# Hybrid Video AI Detector - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sightengine Commercial AI Video Detection API Credentials
# Obtain your free API credentials at: https://sightengine.com/
# Leave blank if you wish to run the hybrid system in local-only mode.
# ------------------------------------------------------------------------------
SIGHTENGINE_API_USER=your_sightengine_api_user_here
SIGHTENGINE_API_SECRET=your_sightengine_api_secret_here

# ------------------------------------------------------------------------------
# 2. Hugging Face Access Token (Optional)
# Used to enable higher rate limits when downloading public model checkpoints.
# The Sora/Veo2 ResNet-50 model is public and does not require an authenticated token.
# ------------------------------------------------------------------------------
HF_TOKEN=your_optional_hf_token_here

# ------------------------------------------------------------------------------
# 3. Model Engine Toggles
# Enable or disable individual detection engines in the hybrid ensemble.
# ------------------------------------------------------------------------------
ENABLE_CUSTOM_DETECTOR=true
ENABLE_HF_DETECTOR=true
ENABLE_SIGHTENGINE_API=true

# ------------------------------------------------------------------------------
# 4. Service Ports
# ------------------------------------------------------------------------------
VIDEO_DETECTOR_PORT=8001
TEXT_DETECTOR_PORT=8000
